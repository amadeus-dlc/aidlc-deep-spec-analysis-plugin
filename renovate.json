{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "ソルバーバックエンドは byte-frozen な golden のために固定している（docs/decisions A1・A2）。更新は裁定事項なので Dependency Dashboard での承認を要する",
      "matchPackageNames": ["@informalsystems/quint", "z3-solver"],
      "groupName": "solver backends",
      "dependencyDashboardApproval": true
    },
    {
      "description": "bun ランタイム（CI の setup-bun と mise.toml）と @types/bun は同時に動かす",
      "matchDepNames": ["bun", "@types/bun"],
      "groupName": "bun runtime"
    },
    {
      "description": "GitHub Actions の更新は 1 本の PR に束ねる",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ]
}
